@model IReadOnlyList<Book>
@{
    ViewData["Title"] = "Книги";
}

@if (TempData["Message"] is string message)
{
    <p class="msg">@message</p>
}

<div class="toolbar">
    <form asp-action="Index" method="get" class="search">
        <input type="text" name="search" value="@ViewData["Search"]" placeholder="Търси по заглавие или автор..." />
        <button type="submit">Търси</button>
    </form>
    <a class="add-link" asp-action="Create">+ Добави книга</a>
</div>

<table>
    <thead>
    <tr><th>№</th><th>Заглавие</th><th>Автор</th><th>Статус</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Id</td>
            <td><a asp-action="Details" asp-route-id="@book.Id">@book.Title</a></td>
            <td>@book.Author</td>
            <td class="@(book.IsBorrowed ? "taken" : "free")">
                @(book.IsBorrowed ? "Заета" : "Налична")
            </td>
            <td>
                @if (book.IsBorrowed)
                {
                    <form asp-action="Return" asp-route-id="@book.Id" method="post">
                        <button type="submit">Върни</button>
                    </form>
                }
                else
                {
                    <form asp-action="Borrow" asp-route-id="@book.Id" method="post">
                        <button type="submit">Заеми</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="empty">Няма намерени книги.</p>
}

<p class="count">Налични: @(Model.Count(b => !b.IsBorrowed)) от @Model.Count</p>